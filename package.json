{
  "name": "tree-sitter-clips",
  "version": "0.1.1",
  "description": "tree-sitter grammar for CLIPS",
  "main": "bindings/node",
  "types": "bindings/node",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carologistics/Tree-Sitter-CLIPS.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "Tarik Viehmann, Mohammad Ashar Zaman",
    "email": "viehmann@kbsg.rwth-aachen.de",
    "url": ""
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "clips"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
